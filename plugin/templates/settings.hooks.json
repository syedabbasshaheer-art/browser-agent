{
  "hooks": {
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "npx --no-install browser-agent hook prompt", "timeout": 30 }] }],
    "PostToolUse": [{ "matcher": "Edit|Write|MultiEdit|Artifact", "hooks": [{ "type": "command", "command": "npx --no-install browser-agent hook after-tool", "timeout": 30 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "npx --no-install browser-agent hook stop", "timeout": 30 }] }]
  }
}
